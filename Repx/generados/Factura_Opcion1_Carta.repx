        <Item12 Ref="69" ControlType="XRLabel" Name="lblAdqH" Text="ADQUIRENTE" SizeF="950,30" LocationFloat="1009,265" Font="Arial, 7pt, style=Bold" ForeColor="128,128,128" Dpi="254">
