<?xml version="1.0" encoding="utf-8"?>
<XtraReportsLayoutSerializer SerializerVersion="22.1.15.0" Ref="0" ControlType="DevExpress.XtraReports.UI.XtraReport, DevExpress.XtraReports.v22.1, Version=22.1.15.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" Name="SupportDocument_Opcion3_MediaCarta" SnapGridSize="25" ReportUnit="TenthsOfAMillimeter" PaperKind="Custom" PageWidth="2159" PageHeight="1397" Margins="70,70,70,70" Version="22.1" Dpi="254">
  <Parameters>
    <Item1 Ref="1" Name="EmisorLogoUrl" />
    <Item2 Ref="2" Name="EmisorRazonSocial" />
    <Item3 Ref="3" Name="EmisorNombreComercial" />
    <Item4 Ref="4" Name="EmisorNit" />
    <Item5 Ref="5" Name="EmisorDv" />
    <Item6 Ref="6" Name="EmisorDireccion" />
    <Item7 Ref="7" Name="EmisorCiudad" />
    <Item8 Ref="8" Name="EmisorTelefono" />
    <Item9 Ref="9" Name="EmisorEmail" />
    <Item10 Ref="10" Name="EmisorCalidadTributaria" />
    <Item11 Ref="11" Name="ProveedorNombre" />
    <Item12 Ref="12" Name="ProveedorTipoIdentificacion" />
    <Item13 Ref="13" Name="ProveedorIdentificacion" />
    <Item14 Ref="14" Name="ProveedorDireccion" />
    <Item15 Ref="15" Name="ProveedorCiudad" />
    <Item16 Ref="16" Name="ProveedorTelefono" />
    <Item17 Ref="17" Name="ProveedorEmail" />
    <Item18 Ref="18" Name="DocumentoTitulo" />
    <Item19 Ref="19" Name="DocumentoNumero" />
    <Item20 Ref="20" Name="ResolucionTexto" />
    <Item21 Ref="21" Name="FechaGeneracion" />
    <Item22 Ref="22" Name="ReferenciaAjuste" />
    <Item23 Ref="23" Name="Cufe" />
    <Item24 Ref="24" Name="MedioPago" />
    <Item25 Ref="25" Name="FormaPago" />
    <Item26 Ref="26" Name="OrdenCompra" />
    <Item27 Ref="27" Name="Subtotal" />
    <Item28 Ref="28" Name="Iva" />
    <Item29 Ref="29" Name="Descuento" />
    <Item30 Ref="30" Name="Total" />
    <Item31 Ref="31" Name="TotalEnLetras" />
    <Item32 Ref="32" Name="FabricanteSoftwareNombre" />
    <Item33 Ref="33" Name="FabricanteSoftwareNit" />
    <Item34 Ref="34" Name="NombreSoftware" />
    <Item35 Ref="35" Name="ProveedorTecnologicoNombre" />
    <Item36 Ref="36" Name="ProveedorTecnologicoNit" />
  </Parameters>
  <Bands>
    <Item1 Ref="37" ControlType="TopMarginBand" Name="TopMargin" HeightF="0" Dpi="254" />
    <Item2 Ref="38" ControlType="BottomMarginBand" Name="BottomMargin" HeightF="0" Dpi="254" />

    <!-- Encabezado: solo identificación — nada de totales aquí. A todo el ancho (2019). -->
    <Item3 Ref="39" ControlType="ReportHeaderBand" Name="ReportHeader" HeightF="440" Dpi="254">
      <Controls>
        <Item1 Ref="40" ControlType="XRPictureBox" Name="picLogo" SizeF="220,70" LocationFloat="0,0" Sizing="ZoomImage" Dpi="254">
          <ExpressionBindings>
            <Item1 Ref="41" EventName="BeforePrint" PropertyName="ImageUrl" Expression="[Parameters.EmisorLogoUrl]" />
            <Item2 Ref="42" EventName="BeforePrint" PropertyName="Visible" Expression="Len([Parameters.EmisorLogoUrl]) &gt; 0" />
          </ExpressionBindings>
        </Item1>
        <Item2 Ref="43" ControlType="XRLabel" Name="lblBrandName" SizeF="600,45" LocationFloat="0,5" Font="Arial, 10pt, style=Bold" Dpi="254">
          <ExpressionBindings><Item1 Ref="44" EventName="BeforePrint" PropertyName="Text" Expression="[Parameters.EmisorRazonSocial]" /></ExpressionBindings>
          <StylePriority Ref="45" UseFont="false" />
        </Item2>
        <Item3 Ref="46" ControlType="XRLabel" Name="lblDocTitle" SizeF="850,30" LocationFloat="1169,0" Font="Arial, 7pt, style=Bold" TextAlignment="TopRight" Dpi="254">
          <ExpressionBindings><Item1 Ref="154" EventName="BeforePrint" PropertyName="Text" Expression="[Parameters.DocumentoTitulo]" /></ExpressionBindings>
          <StylePriority Ref="47" UseFont="false" UseTextAlignment="false" />
        </Item3>
        <Item4 Ref="48" ControlType="XRLabel" Name="lblDocNumber" SizeF="850,40" LocationFloat="1169,30" Font="Consolas, 11pt, style=Bold" ForeColor="36,85,201" TextAlignment="TopRight" Dpi="254">
          <ExpressionBindings><Item1 Ref="49" EventName="BeforePrint" PropertyName="Text" Expression="[Parameters.DocumentoNumero]" /></ExpressionBindings>
          <StylePriority Ref="50" UseFont="false" UseForeColor="false" UseTextAlignment="false" />
        </Item4>
        <Item5 Ref="51" ControlType="XRLine" Name="lineTopbar" SizeF="2019,6" LocationFloat="0,80" ForeColor="36,85,201" Dpi="254"><StylePriority Ref="52" UseForeColor="false" /></Item5>

        <Item6 Ref="53" ControlType="XRLabel" Name="lblEmisorH" Text="EMISOR" SizeF="980,25" LocationFloat="0,95" Font="Arial, 6pt, style=Bold" ForeColor="128,128,128" Dpi="254"><StylePriority Ref="54" UseFont="false" UseForeColor="false" /></Item6>
        <Item7 Ref="55" ControlType="XRLabel" Name="lblEmisorNombre" SizeF="980,35" LocationFloat="0,120" Font="Arial, 8.5pt, style=Bold" Dpi="254">
          <ExpressionBindings><Item1 Ref="56" EventName="BeforePrint" PropertyName="Text" Expression="[Parameters.EmisorRazonSocial]" /></ExpressionBindings>
          <StylePriority Ref="57" UseFont="false" />
        </Item7>
        <Item8 Ref="58" ControlType="XRLabel" Name="lblEmisorInfo" SizeF="980,60" LocationFloat="0,155" Font="Arial, 6.5pt" ForeColor="90,90,90" Multiline="true" Dpi="254">
          <ExpressionBindings><Item1 Ref="59" EventName="BeforePrint" PropertyName="Text" Expression="'NIT ' + [Parameters.EmisorNit] + ' — ' + [Parameters.EmisorDireccion] + ', ' + [Parameters.EmisorCiudad] + '&#xA;' + [Parameters.EmisorTelefono] + ' · ' + [Parameters.EmisorEmail]" /></ExpressionBindings>
          <StylePriority Ref="60" UseFont="false" UseForeColor="false" />
        </Item8>
        <Item9 Ref="61" ControlType="XRLabel" Name="lblCalidadTrib" SizeF="980,30" LocationFloat="0,215" Font="Arial, 6.5pt, style=Bold" ForeColor="36,85,201" BackColor="234,240,255" Dpi="254">
          <ExpressionBindings><Item1 Ref="62" EventName="BeforePrint" PropertyName="Text" Expression="[Parameters.EmisorCalidadTributaria]" /></ExpressionBindings>
          <StylePriority Ref="63" UseFont="false" UseForeColor="false" UseBackColor="false" />
        </Item9>

        <Item10 Ref="64" ControlType="XRLabel" Name="lblAdqH" Text="PROVEEDOR" SizeF="1000,25" LocationFloat="1019,95" Font="Arial, 6pt, style=Bold" ForeColor="128,128,128" Dpi="254"><StylePriority Ref="65" UseFont="false" UseForeColor="false" /></Item10>
        <Item11 Ref="66" ControlType="XRLabel" Name="lblAdqNombre" SizeF="1000,35" LocationFloat="1019,120" Font="Arial, 8.5pt, style=Bold" Dpi="254">
          <ExpressionBindings><Item1 Ref="67" EventName="BeforePrint" PropertyName="Text" Expression="[Parameters.ProveedorNombre]" /></ExpressionBindings>
          <StylePriority Ref="68" UseFont="false" />
        </Item11>
        <Item12 Ref="69" ControlType="XRLabel" Name="lblAdqInfo" SizeF="1000,60" LocationFloat="1019,155" Font="Arial, 6.5pt" ForeColor="90,90,90" Multiline="true" Dpi="254">
          <ExpressionBindings><Item1 Ref="70" EventName="BeforePrint" PropertyName="Text" Expression="'NIT/CC ' + [Parameters.ProveedorIdentificacion] + ' — ' + [Parameters.ProveedorDireccion] + ', ' + [Parameters.ProveedorCiudad] + '&#xA;' + [Parameters.ProveedorTelefono] + ' · ' + [Parameters.ProveedorEmail]" /></ExpressionBindings>
          <StylePriority Ref="71" UseFont="false" UseForeColor="false" />
        </Item12>

        <Item13 Ref="72" ControlType="XRPanel" Name="pnlMeta" SizeF="2019,80" LocationFloat="0,255" BackColor="244,245,247" Dpi="254">
          <Controls>
            <Item1 Ref="73" ControlType="XRLabel" Name="lblMetaCombo" SizeF="1999,65" LocationFloat="10,8" Font="Arial, 6.5pt" Multiline="true" Dpi="254">
              <ExpressionBindings><Item1 Ref="74" EventName="BeforePrint" PropertyName="Text" Expression="'Generada: ' + [Parameters.FechaGeneracion] + '   Ref. ajuste: ' + [Parameters.ReferenciaAjuste] + '&#xA;Forma de pago: ' + [Parameters.FormaPago] + '   Medio: ' + [Parameters.MedioPago] + '   O.C.: ' + [Parameters.OrdenCompra]" /></ExpressionBindings>
              <StylePriority Ref="75" UseFont="false" />
            </Item1>
          </Controls>
          <StylePriority Ref="76" UseBackColor="false" />
        </Item13>

        <Item14 Ref="115" ControlType="XRTable" Name="tblItemsHeader" SizeF="2019,45" LocationFloat="0,345" Dpi="254">
          <Rows>
            <Item1 Ref="116" ControlType="XRTableRow" Name="rowItemsHeader" Weight="1" Dpi="254">
              <Cells>
                <Item1 Ref="117" ControlType="XRTableCell" Name="cellH1" Text="Código / Descripción" Weight="2.6" BackColor="244,245,247" Font="Arial, 6.5pt, style=Bold" Dpi="254"><StylePriority Ref="118" UseFont="false" UseBackColor="false" /></Item1>
                <Item2 Ref="119" ControlType="XRTableCell" Name="cellH2" Text="Cant." Weight="0.6" BackColor="244,245,247" Font="Arial, 6.5pt, style=Bold" TextAlignment="MiddleRight" Dpi="254"><StylePriority Ref="120" UseFont="false" UseBackColor="false" UseTextAlignment="false" /></Item2>
                <Item3 Ref="121" ControlType="XRTableCell" Name="cellH3" Text="Unidad" Weight="0.7" BackColor="244,245,247" Font="Arial, 6.5pt, style=Bold" Padding="20,5,0,0,254" Dpi="254"><StylePriority Ref="122" UseFont="false" UseBackColor="false" /></Item3>
                <Item4 Ref="123" ControlType="XRTableCell" Name="cellH4" Text="Vlr. Unit." Weight="1" BackColor="244,245,247" Font="Arial, 6.5pt, style=Bold" TextAlignment="MiddleRight" Dpi="254"><StylePriority Ref="124" UseFont="false" UseBackColor="false" UseTextAlignment="false" /></Item4>
                <Item5 Ref="125" ControlType="XRTableCell" Name="cellH5" Text="IVA" Weight="0.6" BackColor="244,245,247" Font="Arial, 6.5pt, style=Bold" TextAlignment="MiddleRight" Dpi="254"><StylePriority Ref="126" UseFont="false" UseBackColor="false" UseTextAlignment="false" /></Item5>
                <Item6 Ref="127" ControlType="XRTableCell" Name="cellH6" Text="Total" Weight="1" BackColor="244,245,247" Font="Arial, 6.5pt, style=Bold" TextAlignment="MiddleRight" Dpi="254"><StylePriority Ref="128" UseFont="false" UseBackColor="false" UseTextAlignment="false" /></Item6>
              </Cells>
            </Item1>
          </Rows>
        </Item14>
      </Controls>
    </Item3>

    <Item4 Ref="129" ControlType="DetailBand" Name="Detail" HeightF="40" Dpi="254">
      <Controls>
        <Item1 Ref="130" ControlType="XRTable" Name="tblItemRow" SizeF="2019,40" LocationFloat="0,0" Dpi="254">
          <Rows>
            <Item1 Ref="131" ControlType="XRTableRow" Name="rowItem" Weight="1" Dpi="254">
              <Cells>
                <Item1 Ref="132" ControlType="XRTableCell" Name="cellD1" Weight="2.6" Font="Arial, 7pt" Dpi="254">
                  <ExpressionBindings><Item1 Ref="133" EventName="BeforePrint" PropertyName="Text" Expression="[Codigo] + ' — ' + [Nombre]" /></ExpressionBindings>
                  <StylePriority Ref="134" UseFont="false" />
                </Item1>
                <Item2 Ref="135" ControlType="XRTableCell" Name="cellD2" Weight="0.6" Font="Arial, 7pt" TextAlignment="MiddleRight" Dpi="254">
                  <ExpressionBindings><Item1 Ref="136" EventName="BeforePrint" PropertyName="Text" Expression="[Cantidad]" /></ExpressionBindings>
                  <StylePriority Ref="137" UseFont="false" UseTextAlignment="false" />
                </Item2>
                <Item3 Ref="138" ControlType="XRTableCell" Name="cellD3" Weight="0.7" Font="Arial, 7pt" Padding="20,5,0,0,254" Dpi="254">
                  <ExpressionBindings><Item1 Ref="139" EventName="BeforePrint" PropertyName="Text" Expression="[Unidad]" /></ExpressionBindings>
                  <StylePriority Ref="140" UseFont="false" />
                </Item3>
                <Item4 Ref="141" ControlType="XRTableCell" Name="cellD4" Weight="1" Font="Arial, 7pt" TextAlignment="MiddleRight" Dpi="254">
                  <ExpressionBindings><Item1 Ref="142" EventName="BeforePrint" PropertyName="Text" Expression="[ValorUnitario]" /></ExpressionBindings>
                  <StylePriority Ref="143" UseFont="false" UseTextAlignment="false" />
                </Item4>
                <Item5 Ref="144" ControlType="XRTableCell" Name="cellD5" Weight="0.6" Font="Arial, 7pt" TextAlignment="MiddleRight" Dpi="254">
                  <ExpressionBindings><Item1 Ref="145" EventName="BeforePrint" PropertyName="Text" Expression="[PorcentajeIva]" /></ExpressionBindings>
                  <StylePriority Ref="146" UseFont="false" UseTextAlignment="false" />
                </Item5>
                <Item6 Ref="147" ControlType="XRTableCell" Name="cellD6" Weight="1" Font="Arial, 7pt, style=Bold" TextAlignment="MiddleRight" Dpi="254">
                  <ExpressionBindings><Item1 Ref="148" EventName="BeforePrint" PropertyName="Text" Expression="[TotalLinea]" /></ExpressionBindings>
                  <StylePriority Ref="149" UseFont="false" UseTextAlignment="false" />
                </Item6>
              </Cells>
            </Item1>
          </Rows>
        </Item1>
      </Controls>
    </Item4>

    <!-- Pie: resumen (QR, CUFE, resolución, totales, "Son", legal, fabricante) — fijado al
         fondo de la página con PrintAtBottom, siempre al final sin importar cuántos ítems traiga. -->
    <Item5 Ref="150" ControlType="ReportFooterBand" Name="ReportFooter" HeightF="330" PrintAtBottom="true" Dpi="254">
      <Controls>
        <Item1 Ref="151b" ControlType="XRLine" Name="lineTotals" SizeF="2019,4" LocationFloat="0,0" ForeColor="200,200,200" Dpi="254"><StylePriority Ref="153b" UseForeColor="false" /></Item1>

        <Item2 Ref="78" ControlType="XRPictureBox" Name="picQr" SizeF="120,120" LocationFloat="0,15" Dpi="254">
          <ExpressionBindings><Item1 Ref="79" EventName="BeforePrint" PropertyName="ImageUrl" Expression="'https://api.qrserver.com/v1/create-qr-code/?size=150x150&amp;data=' + [Parameters.Cufe]" /></ExpressionBindings>
        </Item2>
        <Item3 Ref="80" ControlType="XRLabel" Name="lblCufe" SizeF="620,55" LocationFloat="130,15" Font="Consolas, 5.5pt" ForeColor="90,90,90" Multiline="true" Dpi="254">
          <ExpressionBindings><Item1 Ref="81" EventName="BeforePrint" PropertyName="Text" Expression="'CUFE: ' + [Parameters.Cufe]" /></ExpressionBindings>
          <StylePriority Ref="82" UseFont="false" UseForeColor="false" />
        </Item3>
        <Item4 Ref="83" ControlType="XRLabel" Name="lblResolucion" SizeF="620,60" LocationFloat="130,70" Font="Arial, 6.5pt" ForeColor="90,90,90" Multiline="true" Dpi="254">
          <ExpressionBindings><Item1 Ref="84" EventName="BeforePrint" PropertyName="Text" Expression="[Parameters.ResolucionTexto]" /></ExpressionBindings>
          <StylePriority Ref="85" UseFont="false" UseForeColor="false" />
        </Item4>

        <Item5 Ref="88" ControlType="XRLabel" Name="lblSubtotalKV" SizeF="500,25" LocationFloat="800,15" Font="Arial, 6.5pt" ForeColor="90,90,90" Dpi="254">
          <ExpressionBindings><Item1 Ref="89" EventName="BeforePrint" PropertyName="Text" Expression="'Subtotal: ' + [Parameters.Subtotal]" /></ExpressionBindings>
          <StylePriority Ref="90" UseFont="false" UseForeColor="false" />
        </Item5>
        <Item6 Ref="91" ControlType="XRLabel" Name="lblDescuentoKV" SizeF="500,25" LocationFloat="800,40" Font="Arial, 6.5pt" ForeColor="90,90,90" Dpi="254">
          <ExpressionBindings><Item1 Ref="92" EventName="BeforePrint" PropertyName="Text" Expression="'Descuento: -' + [Parameters.Descuento]" /></ExpressionBindings>
          <StylePriority Ref="93" UseFont="false" UseForeColor="false" />
        </Item6>
        <Item7 Ref="94" ControlType="XRLabel" Name="lblIvaKV" SizeF="500,25" LocationFloat="800,65" Font="Arial, 6.5pt" ForeColor="90,90,90" Dpi="254">
          <ExpressionBindings><Item1 Ref="95" EventName="BeforePrint" PropertyName="Text" Expression="'IVA: ' + [Parameters.Iva]" /></ExpressionBindings>
          <StylePriority Ref="96" UseFont="false" UseForeColor="false" />
        </Item7>
        <Item8 Ref="97" ControlType="XRLine" Name="lineSide2" SizeF="500,6" LocationFloat="800,95" ForeColor="36,85,201" Dpi="254"><StylePriority Ref="98" UseForeColor="false" /></Item8>
        <Item9 Ref="99" ControlType="XRLabel" Name="lblTotalKV" SizeF="500,40" LocationFloat="800,105" Font="Consolas, 9pt, style=Bold" ForeColor="36,85,201" Dpi="254">
          <ExpressionBindings><Item1 Ref="100" EventName="BeforePrint" PropertyName="Text" Expression="'TOTAL: ' + [Parameters.Total]" /></ExpressionBindings>
          <StylePriority Ref="101" UseFont="false" UseForeColor="false" />
        </Item9>
        <Item10 Ref="102" ControlType="XRLabel" Name="lblTotalLetras" SizeF="500,50" LocationFloat="800,145" Font="Arial, 5.5pt, style=Italic" ForeColor="90,90,90" Multiline="true" Dpi="254">
          <ExpressionBindings><Item1 Ref="103" EventName="BeforePrint" PropertyName="Text" Expression="'Son: ' + [Parameters.TotalEnLetras]" /></ExpressionBindings>
          <StylePriority Ref="104" UseFont="false" UseForeColor="false" />
        </Item10>

        <Item11 Ref="105" ControlType="XRLine" Name="lineSide3" SizeF="2019,4" LocationFloat="0,210" ForeColor="220,220,220" Dpi="254"><StylePriority Ref="106" UseForeColor="false" /></Item11>
        <Item12 Ref="151" ControlType="XRLabel" Name="lblLegal" SizeF="2019,25" LocationFloat="0,220" Font="Arial, 6pt" ForeColor="128,128,128" TextAlignment="TopCenter" Multiline="true" Dpi="254">
          <ExpressionBindings><Item1 Ref="152" EventName="BeforePrint" PropertyName="Text" Expression="'Representación gráfica de la Factura Electrónica de Venta — no requiere firma manuscrita (ley 527 de 1999).'" /></ExpressionBindings>
          <StylePriority Ref="153" UseFont="false" UseForeColor="false" UseTextAlignment="false" />
        </Item12>
        <Item13 Ref="107" ControlType="XRLabel" Name="lblFabricante" SizeF="1000,45" LocationFloat="0,250" Font="Arial, 5.5pt" ForeColor="90,90,90" Multiline="true" Dpi="254">
          <ExpressionBindings><Item1 Ref="108" EventName="BeforePrint" PropertyName="Text" Expression="'Fabricante: ' + [Parameters.FabricanteSoftwareNombre] + ' NIT ' + [Parameters.FabricanteSoftwareNit] + '&#xA;Software: ' + [Parameters.NombreSoftware]" /></ExpressionBindings>
          <StylePriority Ref="109" UseFont="false" UseForeColor="false" />
        </Item13>
        <Item14 Ref="110" ControlType="XRLabel" Name="lblProveedor" SizeF="1000,45" LocationFloat="1019,250" Font="Arial, 5.5pt" ForeColor="90,90,90" Multiline="true" Dpi="254">
          <ExpressionBindings>
            <Item1 Ref="111" EventName="BeforePrint" PropertyName="Text" Expression="'Prov. Tecnológico: ' + [Parameters.ProveedorTecnologicoNombre] + ' NIT ' + [Parameters.ProveedorTecnologicoNit]" />
            <Item2 Ref="112" EventName="BeforePrint" PropertyName="Visible" Expression="Len([Parameters.ProveedorTecnologicoNombre]) &gt; 0" />
          </ExpressionBindings>
          <StylePriority Ref="113" UseFont="false" UseForeColor="false" />
        </Item14>
      </Controls>
    </Item5>
  </Bands>
</XtraReportsLayoutSerializer>
