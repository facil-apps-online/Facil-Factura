# syntax=docker/dockerfile:1
# Multi-stage parametrizable: ARG PROJECT = Fel.Api.Tenant | Fel.Api.Integration | Fel.Api.Superadmin | Fel.Api.Client | Fel.Worker
ARG PROJECT=Fel.Api.Tenant

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
ARG PROJECT=Fel.Api.Tenant

# Copy solution and project files for restore
COPY src/Fel.sln .
COPY src/Fel.Core/Fel.Core.csproj Fel.Core/
COPY src/Fel.Infrastructure/Fel.Infrastructure.csproj Fel.Infrastructure/
COPY src/Fel.Api.Tenant/Fel.Api.Tenant.csproj Fel.Api.Tenant/
COPY src/Fel.Api.Integration/Fel.Api.Integration.csproj Fel.Api.Integration/
COPY src/Fel.Api.Superadmin/Fel.Api.Superadmin.csproj Fel.Api.Superadmin/
COPY src/Fel.Api.Client/Fel.Api.Client.csproj Fel.Api.Client/
COPY src/Fel.Worker/Fel.Worker.csproj Fel.Worker/
RUN dotnet restore Fel.sln

# Copy all source and publish the target project
COPY src/ src/
RUN dotnet publish "src/${PROJECT}/${PROJECT}.csproj" -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app

# Install curl for healthchecks + fontconfig for SkiaSharp text rendering
RUN apt-get update && apt-get install -y --no-install-recommends curl libfontconfig1 fontconfig \
    && rm -rf /var/lib/apt/lists/*

# SkiaSharp native libs for DevExpress rendering on Linux
ENV SKIA_LIBRARY_PATH=/usr/lib/libSkiaSharp.so

COPY --from=build /app/publish .

# Colocar libSkiaSharp nativa donde la espera SKIA_LIBRARY_PATH (solo presente si el proyecto usa SkiaSharp)
RUN cp /app/publish/runtimes/linux-x64/native/libSkiaSharp.so /usr/lib/ 2>/dev/null || true

ARG PROJECT=Fel.Api.Tenant
ENV ASPNETCORE_ENVIRONMENT=Production
ENV PROJECT_NAME=${PROJECT}.dll

ENTRYPOINT ["sh", "-c", "dotnet /app/$PROJECT_NAME"]
