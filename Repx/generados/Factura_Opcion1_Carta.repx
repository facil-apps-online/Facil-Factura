            <Item1 Ref="75" EventName="BeforePrint" PropertyName="Text" Expression="'NIT/CC ' + [Parameters.AdquirenteIdentificacion] + '&#xA;' + [Parameters.AdquirenteDireccion] + ', ' + [Parameters.AdquirenteCiudad] + '&#xA;' + [Parameters.AdquirenteTelefono] + ' · ' + [Parameters.AdquirenteEmail]" />
