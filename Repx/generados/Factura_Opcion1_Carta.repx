                <Item3 Ref="127" ControlType="XRTableCell" Name="cellD3" Weight="0.7" Font="Arial, 8pt" Padding="20,5,0,0,254" Dpi="254">
                  <ExpressionBindings><Item1 Ref="128" EventName="BeforePrint" PropertyName="Text" Expression="[Unidad]" /></ExpressionBindings>
                  <StylePriority Ref="129" UseFont="false" />
