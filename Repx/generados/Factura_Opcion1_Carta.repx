        <Item6 Ref="152" ControlType="XRLabel" Name="lblIvaK" Text="IVA" SizeF="300,30" LocationFloat="1359,90" Font="Arial, 8pt" ForeColor="128,128,128" Dpi="254"><StylePriority Ref="153" UseFont="false" UseForeColor="false" /></Item6>
        <Item7 Ref="154" ControlType="XRLabel" Name="lblIvaV" SizeF="300,30" LocationFloat="1659,90" Font="Arial, 8pt, style=Bold" TextAlignment="MiddleRight" Dpi="254">
          <ExpressionBindings><Item1 Ref="155" EventName="BeforePrint" PropertyName="Text" Expression="[Parameters.Iva]" /></ExpressionBindings>
          <StylePriority Ref="156" UseFont="false" UseTextAlignment="false" />
