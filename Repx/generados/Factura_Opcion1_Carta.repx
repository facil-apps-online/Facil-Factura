        </Item1>
        <Item2 Ref="43" ControlType="XRLabel" Name="lblBrandName" SizeF="750,80" LocationFloat="0,10" Font="Arial, 13pt, style=Bold" Dpi="254">
          <ExpressionBindings>
            <Item1 Ref="44" EventName="BeforePrint" PropertyName="Text" Expression="[Parameters.EmisorRazonSocial]" />
          </ExpressionBindings>
