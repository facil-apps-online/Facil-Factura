                <Item4 Ref="112" ControlType="XRTableCell" Name="cellH4" Text="Valor Unit." Weight="1" BackColor="244,245,247" Font="Arial, 7.5pt, style=Bold" TextAlignment="MiddleRight" Dpi="254"><StylePriority Ref="113" UseFont="false" UseBackColor="false" UseTextAlignment="false" /></Item4>
                <Item5 Ref="114" ControlType="XRTableCell" Name="cellH5" Text="IVA" Weight="0.6" BackColor="244,245,247" Font="Arial, 7.5pt, style=Bold" TextAlignment="MiddleRight" Dpi="254"><StylePriority Ref="115" UseFont="false" UseBackColor="false" UseTextAlignment="false" /></Item5>
                <Item6 Ref="116" ControlType="XRTableCell" Name="cellH6" Text="Total" Weight="1" BackColor="244,245,247" Font="Arial, 7.5pt, style=Bold" TextAlignment="MiddleRight" Dpi="254"><StylePriority Ref="117" UseFont="false" UseBackColor="false" UseTextAlignment="false" /></Item6>
