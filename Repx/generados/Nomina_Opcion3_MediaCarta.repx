<XtraReportsLayoutSerializer SerializerVersion="22.1.15.0" Ref="0" ControlType="DevExpress.XtraReports.UI.XtraReport, DevExpress.XtraReports.v22.1, Version=22.1.15.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" Name="Nomina_Opcion3_MediaCarta" SnapGridSize="25" ReportUnit="TenthsOfAMillimeter" Margins="100, 100, 60, 60" PaperKind="Custom" PageWidth="2159" PageHeight="1397" Version="22.1" Dpi="254">
  <Bands>
