        </Item1>
        <Item2 Ref="142" ControlType="XRLabel" Name="lblSubtotalK" Text="Subtotal" SizeF="300,30" LocationFloat="1359,20" Font="Arial, 8pt" ForeColor="128,128,128" Dpi="254"><StylePriority Ref="143" UseFont="false" UseForeColor="false" /></Item2>
        <Item3 Ref="144" ControlType="XRLabel" Name="lblSubtotalV" SizeF="300,30" LocationFloat="1659,20" Font="Arial, 8pt, style=Bold" TextAlignment="MiddleRight" Dpi="254">
          <ExpressionBindings><Item1 Ref="145" EventName="BeforePrint" PropertyName="Text" Expression="[Parameters.Subtotal]" /></ExpressionBindings>
          <StylePriority Ref="146" UseFont="false" UseTextAlignment="false" />
        </Item3>
        <Item4 Ref="147" ControlType="XRLabel" Name="lblDescuentoK" Text="Descuento" SizeF="300,30" LocationFloat="1359,55" Font="Arial, 8pt" ForeColor="128,128,128" Dpi="254"><StylePriority Ref="148" UseFont="false" UseForeColor="false" /></Item4>
        <Item5 Ref="149" ControlType="XRLabel" Name="lblDescuentoV" SizeF="300,30" LocationFloat="1659,55" Font="Arial, 8pt, style=Bold" TextAlignment="MiddleRight" Dpi="254">
          <ExpressionBindings><Item1 Ref="150" EventName="BeforePrint" PropertyName="Text" Expression="'-' + [Parameters.Descuento]" /></ExpressionBindings>
          <StylePriority Ref="151" UseFont="false" UseTextAlignment="false" />
