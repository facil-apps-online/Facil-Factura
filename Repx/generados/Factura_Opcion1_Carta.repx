  <Bands>
    <Item1 Ref="37" ControlType="TopMarginBand" Name="TopMargin" HeightF="0" Dpi="254" />
    <Item2 Ref="38" ControlType="BottomMarginBand" Name="BottomMargin" HeightF="0" Dpi="254" />

    <Item3 Ref="39" ControlType="ReportHeaderBand" Name="ReportHeader" HeightF="920" Dpi="254">
      <Controls>
        <Item1 Ref="40" ControlType="XRPictureBox" Name="picLogo" SizeF="350,150" LocationFloat="0,0" Sizing="ZoomImage" Dpi="254">
