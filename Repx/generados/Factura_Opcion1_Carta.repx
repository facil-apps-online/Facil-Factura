    <Item4 Ref="118" ControlType="DetailBand" Name="Detail" HeightF="55" Dpi="254">
      <Controls>
        <Item1 Ref="119" ControlType="XRTable" Name="tblItemRow" SizeF="1959,55" LocationFloat="0,0" Dpi="254">
          <Rows>
            <Item1 Ref="120" ControlType="XRTableRow" Name="rowItem" Weight="1" Dpi="254">
              <Cells>
                <Item1 Ref="121" ControlType="XRTableCell" Name="cellD1" Weight="2.6" Font="Arial, 8pt" Dpi="254">
                  <ExpressionBindings><Item1 Ref="122" EventName="BeforePrint" PropertyName="Text" Expression="[Codigo] + ' — ' + [Nombre]" /></ExpressionBindings>
                  <StylePriority Ref="123" UseFont="false" />
                </Item1>
                <Item2 Ref="124" ControlType="XRTableCell" Name="cellD2" Weight="0.6" Font="Arial, 8pt" TextAlignment="MiddleRight" Dpi="254">
                  <ExpressionBindings><Item1 Ref="125" EventName="BeforePrint" PropertyName="Text" Expression="[Cantidad]" /></ExpressionBindings>
                  <StylePriority Ref="126" UseFont="false" UseTextAlignment="false" />
