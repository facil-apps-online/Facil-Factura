            <Item1 Ref="22" EventName="BeforePrint" PropertyName="Text" Expression="'Actividad Económica Principal: ' + [Documento.EmisorActividadEconomica] + Iif([Documento.EmisorRegimenRenta] = '', '', '   ·   Renta: ' + [Documento.EmisorRegimenRenta])" />
