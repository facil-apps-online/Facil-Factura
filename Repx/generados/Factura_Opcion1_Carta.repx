            <Item1 Ref="172" EventName="BeforePrint" PropertyName="Text" Expression="'Fabricante del software: ' + [Parameters.FabricanteSoftwareNombre] + ' · NIT ' + [Parameters.FabricanteSoftwareNit] + '&#xA;Nombre del software: ' + [Parameters.NombreSoftware]" />
          </ExpressionBindings>
          <StylePriority Ref="173" UseFont="false" UseForeColor="false" />
        </Item14>
        <Item15 Ref="174" ControlType="XRLabel" Name="lblProveedor" SizeF="850,60" LocationFloat="1090,350" Font="Arial, 7pt" ForeColor="90,90,90" Multiline="true" Dpi="254">
          <ExpressionBindings>
            <Item1 Ref="175" EventName="BeforePrint" PropertyName="Text" Expression="'Proveedor Tecnológico: ' + [Parameters.ProveedorTecnologicoNombre] + ' · NIT ' + [Parameters.ProveedorTecnologicoNit]" />
