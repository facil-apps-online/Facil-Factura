        <Item8 Ref="157" ControlType="XRLine" Name="lineGrand" SizeF="600,6" LocationFloat="1359,128" ForeColor="36,85,201" Dpi="254"><StylePriority Ref="158" UseForeColor="false" /></Item8>
        <Item9 Ref="159" ControlType="XRLabel" Name="lblTotalK" Text="TOTAL" SizeF="300,50" LocationFloat="1359,138" Font="Arial, 9pt, style=Bold" Dpi="254"><StylePriority Ref="160" UseFont="false" /></Item9>
        <Item10 Ref="161" ControlType="XRLabel" Name="lblTotalV" SizeF="300,50" LocationFloat="1659,138" Font="Consolas, 12pt, style=Bold" ForeColor="36,85,201" TextAlignment="MiddleRight" Dpi="254">
          <ExpressionBindings><Item1 Ref="162" EventName="BeforePrint" PropertyName="Text" Expression="[Parameters.Total]" /></ExpressionBindings>
          <StylePriority Ref="163" UseFont="false" UseForeColor="false" UseTextAlignment="false" />
