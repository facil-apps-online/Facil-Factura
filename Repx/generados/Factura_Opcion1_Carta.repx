                  <StylePriority Ref="135" UseFont="false" UseTextAlignment="false" />
                </Item5>
                <Item6 Ref="136" ControlType="XRTableCell" Name="cellD6" Weight="1" Font="Arial, 8pt, style=Bold" TextAlignment="MiddleRight" Dpi="254">
                  <ExpressionBindings><Item1 Ref="137" EventName="BeforePrint" PropertyName="Text" Expression="[TotalLinea]" /></ExpressionBindings>
                  <StylePriority Ref="138" UseFont="false" UseTextAlignment="false" />
                </Item6>
              </Cells>
            </Item1>
          </Rows>
        </Item1>
      </Controls>
    </Item4>

    <Item5 Ref="139" ControlType="ReportFooterBand" Name="ReportFooter" HeightF="620" PrintAtBottom="true" Dpi="254">
      <Controls>
        <Item1 Ref="140" ControlType="XRLine" Name="lineTotals" SizeF="1959,10" LocationFloat="0,0" ForeColor="200,200,200" Dpi="254">
