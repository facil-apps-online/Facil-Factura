        <Item16 Ref="179" ControlType="XRLabel" Name="lblTotalLetras" SizeF="1959,45" LocationFloat="0,192" Font="Arial, 7.5pt, style=Italic" ForeColor="90,90,90" Dpi="254">
          <ExpressionBindings>
            <Item1 Ref="180" EventName="BeforePrint" PropertyName="Text" Expression="'Son: ' + [Parameters.TotalEnLetras]" />
          </ExpressionBindings>
          <StylePriority Ref="181" UseFont="false" UseForeColor="false" />
        </Item16>
        <Item11 Ref="164" ControlType="XRPictureBox" Name="picQr" SizeF="220,220" LocationFloat="0,245" Dpi="254">
          <ExpressionBindings>
            <Item1 Ref="165" EventName="BeforePrint" PropertyName="ImageUrl" Expression="'https://api.qrserver.com/v1/create-qr-code/?size=150x150&amp;data=' + [Parameters.Cufe]" />
          </ExpressionBindings>
        </Item11>
        <Item12 Ref="166" ControlType="XRLabel" Name="lblLegal" SizeF="1700,90" LocationFloat="240,245" Font="Arial, 7pt" ForeColor="90,90,90" Multiline="true" Dpi="254">
          <ExpressionBindings>
            <Item1 Ref="167" EventName="BeforePrint" PropertyName="Text" Expression="'Representación gráfica de la ' + [Parameters.DocumentoTipo] + ', generada a partir del XML autorizado por la DIAN.&#xA;CUFE: ' + [Parameters.Cufe] + '&#xA;Este documento no requiere firma manuscrita — ley 527 de 1999.'" />
          </ExpressionBindings>
          <StylePriority Ref="168" UseFont="false" UseForeColor="false" />
        </Item12>
        <Item13 Ref="169" ControlType="XRLine" Name="lineSoftware" SizeF="1700,4" LocationFloat="240,340" ForeColor="220,220,220" Dpi="254"><StylePriority Ref="170" UseForeColor="false" /></Item13>
        <Item14 Ref="171" ControlType="XRLabel" Name="lblFabricante" SizeF="850,60" LocationFloat="240,350" Font="Arial, 7pt" ForeColor="90,90,90" Multiline="true" Dpi="254">
