        <Item3 Ref="46" ControlType="XRLabel" Name="lblBrandTag" Text="Emisor electrónico" SizeF="750,50" LocationFloat="0,95" Font="Arial, 8pt" ForeColor="128,128,128" Dpi="254">
          <StylePriority Ref="47" UseFont="false" UseForeColor="false" />
